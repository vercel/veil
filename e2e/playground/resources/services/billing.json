{
  "$schema": "../../public/r/service/kind.schema.json",
  "metadata": {
    "kind": "service",
    "name": "billing"
  },
  "spec": {
    "image": "acme/billing:0.9.0",
    "replicas": 3,
    "publishLabels": true
  },
  "dependencies": [
    {
      "kind": "postgres",
      "name": "billing-db",
      "params": {
        "envVar": "BILLING_DATABASE_URL"
      },
      "forward": true
    },
    {
      "kind": "vpc",
      "name": "acme-global"
    }
  ]
}
