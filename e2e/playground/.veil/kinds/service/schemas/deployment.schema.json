{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "replicas",
    "port",
    "region"
  ],
  "properties": {
    "image": {
      "type": "string"
    },
    "replicas": {
      "type": "integer",
      "minimum": 1
    },
    "port": {
      "type": "integer"
    },
    "region": {
      "type": "string"
    },
    "public": {
      "type": "boolean"
    },
    "labels": {
      "type": "object",
      "description": "Standard labels, seeded from the kind's labels.json asset.",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
