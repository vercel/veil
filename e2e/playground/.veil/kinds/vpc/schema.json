{
  "$schema": "http://json-schema.org/draft-07/schema",
  "description": "An Acme VPC — the network every other resource is placed in.",
  "type": "object",
  "additionalProperties": false,
  "required": ["cidr"],
  "properties": {
    "cidr": { "type": "string", "description": "Address range, e.g. 10.0.0.0/16" },
    "availabilityZones": { "type": "integer", "minimum": 1, "maximum": 6, "default": 3 }
  }
}
