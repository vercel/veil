{
  "$schema": "https://raw.githubusercontent.com/vercel/veil/main/api/jsonschema/KindDefinition.schema.json",
  "name": "redis",
  "schema": "./schema.json",
  "sources": [
    {
      "path": "./sources/cache.yaml",
      "schema": "./schemas/cache.schema.json"
    }
  ],
  "hooks": {
    "render": [
      {
        "path": "./hooks/src/size-nodes.ts"
      }
    ],
    "dependents": [
      {
        "kind": "service",
        "paths": [
          "./hooks/src/dependents/inject-redis-url.ts"
        ],
        "params_path": "./schemas/service.params.json"
      }
    ]
  }
}
