{
  "name": "secret",
  "schema": "./schema.json",
  "sources": [
    {
      "path": "./sources/secret.json",
      "schema": "./schemas/secret.schema.json"
    }
  ],
  "hooks": {
    "render": [
      {
        "path": "./hooks/src/set-rotation.ts"
      }
    ],
    "dependents": [
      {
        "kind": "postgres",
        "paths": [
          "./hooks/src/dependents/attach-to-postgres.ts"
        ],
        "params_path": "./schemas/postgres.params.json"
      }
    ]
  }
}
